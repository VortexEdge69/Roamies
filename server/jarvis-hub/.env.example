# Jarvis Hub settings. Copy to .env (chmod 600) and fill in.

# --- server ---
PORT=8787
# Keep 127.0.0.1 behind Caddy. 0.0.0.0 only for testing on your LAN.
HOST=127.0.0.1
HUB_DATA_DIR=/var/lib/jarvis-hub
TZ=Asia/Kolkata

# --- personality ---
HUB_ASSISTANT_NAME=Jarvis
# How Jarvis addresses you
HUB_USER_NAME=sir

# --- brain (pick one) ---
# Your Claude Pro/Max subscription, signed in through a link (no API key):
#   sudo bash /opt/jarvis/server/jarvis-hub/deploy/login.sh   writes these two lines for you
# HUB_PROVIDER=claude
# CLAUDE_CODE_OAUTH_TOKEN=
# HUB_MODEL=haiku        (haiku is quickest for voice; sonnet or opus are smarter)
#
# ...or an Anthropic API key:
ANTHROPIC_API_KEY=
HUB_MODEL=claude-haiku-5-5
# ...or any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Ollama):
# HUB_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# HUB_MODEL=llama-3.3-70b-versatile

# --- speech to text (pendant + phone voice) ---
# Groq Whisper is the default: fast and cheap. Get a key at console.groq.com
GROQ_API_KEY=
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
# Leave empty to auto-detect language (works for English/Telugu mixes)
# STT_LANGUAGE=

# --- routing ---
# Which device speaks replies to pendant requests (a device name from `npm run device -- list`).
# Empty: the asking device if it can speak, else a desktop.
HUB_SPEAKER=
# "hub" (default): the hub's brain answers the pendant and can hand computer tasks to the desktop.
# "desktop": every pendant request goes straight to the desktop Roamies agent (needs the desktop online).
HUB_PENDANT_ROUTE=hub
